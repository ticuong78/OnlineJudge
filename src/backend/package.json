{
  "name": "@oj/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "seed": "tsc -p tsconfig.build.json && node --enable-source-maps dist/seed.js",
    "test:e2e": "tsc -p tsconfig.build.json && node --import tsx --test --test-concurrency=1 ../../e2e/api/*.e2e.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "@oj/contracts": "workspace:*",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "jszip": "3.10.2",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "unpdf": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15"
  }
}
