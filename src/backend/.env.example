PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://oj:oj@localhost:5432/online_judge
# Auto-create/alter tables from entities. Convenient for development; turn off in production.
DB_SYNC=true
# Optional: CA certificate file for hosted Postgres over SSL (Supabase: Settings > Database > SSL)
DATABASE_SSL_CA=
REDIS_URL=redis://localhost:6379

# Key that signs login tokens. REQUIRED in production: 32+ random characters, e.g.  openssl rand -hex 32
# Leave empty in development: a random key is used for each run (you are signed out when the server restarts).
# The server refuses to start with a short or placeholder key - anyone who knows it could sign in as the admin.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Set NODE_ENV=production on a real server. It turns the safety checks on: JWT_SECRET is required and the
# administrator password must be strong (12+ characters, not a well-known default).
# NODE_ENV=production

# Behind a reverse proxy (nginx, Caddy, a load balancer)? Say how many proxies sit in front of this API, so the
# login/sign-up limits see each visitor's real address instead of the proxy's:  TRUST_PROXY=1
# Leave unset when clients connect directly. Do not use "true": it trusts any X-Forwarded-For header
# (refused when NODE_ENV=production).
# TRUST_PROXY=1

# The single administrator account, created on first start if it does not exist.
# admin12345 is a development convenience only: with NODE_ENV=production the server will not create the account
# with a weak or well-known password.
ADMIN_EMAIL=admin@oj.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Quản trị viên

# Max submissions per user waiting in the judge queue at the same time
MAX_PENDING_SUBMISSIONS=3
# A submission whose job vanished from the queue (queue data lost, engine crashed on it) is ended with a system
# error after this many seconds, so the student is not locked out by submissions that will never be judged.
# Jobs that are still queued or running are left alone until the "give up" time (a hung engine).
JUDGE_STALE_AFTER_SECONDS=300
JUDGE_GIVE_UP_AFTER_SECONDS=1800

# Public URL of the frontend (used in teacher invitation links)
FRONTEND_URL=http://localhost:3000

# Email for OTP codes and invitations. Leave SMTP_HOST empty in development:
# emails are then printed to the server log instead of being sent. Required in production (the server refuses to start without it).
# Gmail: enable 2-Step Verification, create an App Password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Online Judge <your.account@gmail.com>"

# Claude (AI exam reader, AI-usage check). Leave empty to disable AI features
# (the rule-based exam reader is used and AI-usage checks are skipped).
ANTHROPIC_API_KEY=
# Models per task (optional): exam reader, AI-usage review
CLAUDE_MODEL=claude-sonnet-5-5
# Test-case suggestions (default: CLAUDE_MODEL)
CLAUDE_TESTGEN_MODEL=
CLAUDE_REVIEW_MODEL=claude-haiku-5-5
